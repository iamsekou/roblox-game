-- The 10-slot roster. In-game names were changed by the owner on 2026-09-23 (Goku -> Gokai, Luffy -> Luffo, ...).
-- id stays the old internal key (code, ability modules, portrait pipeline); players only ever see name.
-- franchise is kept for reference only and is not shown in game. See docs/DESIGN.md 'IP decision'.
--
-- Yen prices are a PLACEHOLDER ladder (owner, 2026-09-23: Krillo 5,000 and the rest scaled by the same x3.33,
-- rounded to 500; the first ladder was 1,500-13,000). At 500 yen an elimination: 10 to 87 eliminations.
-- Robux slots are Game Passes; gamePassId stays nil until the passes exist in the Creator Dashboard.
-- Never invent ids here.
-- portrait: the uploaded bubble image ("rbxassetid://..."), generated by tools/portraits (silhouette style,
-- uploaded 2026-09-23; the earlier colour set's ids are listed in HANDOFF.md). nil until
-- uploaded; the lobby bubble falls back to the character's initials on the bubble colours.
-- abilities: display names only; the rules live server-side (Systems/AbilityService + Systems/Abilities).

export type Tier = "Free" | "Yen" | "Robux"

export type CharacterDef = {
	id: string,
	slot: number,
	name: string,
	franchise: string,
	tier: Tier,
	yenTier: number?, -- 1..6; buying tier N also grants every lower yen tier (Phase 3)
	yenPrice: number?,
	gamePassId: number?,
	identity: string,
	accent: Color3,
	bubbleCenter: Color3,
	bubbleEdge: Color3,
	portrait: string?,
	abilities: { mild: string, ultimate: string }, -- display names (approved sheet, docs/ABILITIES.md)
}

